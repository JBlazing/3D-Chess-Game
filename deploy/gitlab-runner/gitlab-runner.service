# The GitLab Runner for gitlab.com, on jreynolds' rootless Podman: /etc/systemd/system/gitlab-runner.service
# on the pi. Registers first if needed (register.sh, with the token from gitlab-runner.env), then runs the
# runner container in the foreground, so systemd sees it stop and starts it again.
#   sudo systemctl enable --now gitlab-runner
#   journalctl -u gitlab-runner -f
# Needs linger for jreynolds (loginctl enable-linger), so the user session and its Podman socket exist at boot.

[Unit]
Description=GitLab Runner (gitlab.com) on rootless Podman
Wants=network-online.target
After=network-online.target user@1000.service

[Service]
User=jreynolds
Group=jreynolds
# rootless Podman needs the user's runtime directory and session bus
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
EnvironmentFile=/opt/gitlab-runner/gitlab-runner.env
WorkingDirectory=/opt/gitlab-runner
ExecStartPre=/opt/gitlab-runner/register.sh
ExecStart=/usr/bin/podman run --rm --replace --name gitlab-runner \
    -v /opt/gitlab-runner/config:/etc/gitlab-runner \
    -v /run/user/1000/podman/podman.sock:/var/run/docker.sock \
    docker.io/gitlab/gitlab-runner:alpine-v19.5.0
ExecStop=/usr/bin/podman stop -t 30 gitlab-runner
Restart=always
RestartSec=10
# the first start pulls the image and registers
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
