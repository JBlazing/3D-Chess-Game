# Copy to .env next to compose.yaml and fill in. .env holds secrets: keep it out of git.

# where the images come from: localhost:5000 on the pi itself, pi:5000 (or its IP) elsewhere
REGISTRY=localhost:5000
VERSION=0.0.1-SNAPSHOT

DB_PASSWORD=
REDIS_PASSWORD=
ACTIVEMQ_USER=admin
ACTIVEMQ_PASSWORD=

# the Google OAuth client; it must list http://<host>:8080/login/oauth2/code/google as a redirect URI
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# true when the site is served over HTTPS
SESSION_COOKIE_SECURE=false
