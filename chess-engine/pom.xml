<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.jblazing</groupId>
        <artifactId>chess-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <!-- Plays moves for the web app: move requests come off an ActiveMQ queue, Chess.js runs them on GraalJS -->
    <artifactId>chess-engine</artifactId>

    <dependencies>
        <dependency>
            <groupId>com.jblazing</groupId>
            <artifactId>chess-engine-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-activemq</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-json</artifactId>
        </dependency>

        <dependency>
            <groupId>org.graalvm.polyglot</groupId>
            <artifactId>polyglot</artifactId>
            <version>${graaljs.version}</version>
        </dependency>

        <dependency>
            <groupId>org.graalvm.polyglot</groupId>
            <artifactId>js</artifactId>
            <version>${graaljs.version}</version>
            <type>pom</type>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- an ActiveMQ broker inside the test JVM (vm://), so the tests need no server -->
        <dependency>
            <groupId>org.apache.activemq</groupId>
            <artifactId>activemq-broker</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- the runnable jar gets the "exec" classifier; the plain jar stays usable as a
                         dependency, which the web app's tests use to run a real engine -->
                    <classifier>exec</classifier>
                    <jvmArguments>-XX:+UnlockExperimentalVMOptions -XX:+EnableJVMCI</jvmArguments>
                </configuration>
                <executions>
                    <!-- builds the docker image on package, like the web app; it runs the exec jar.
                         Skip with -Dspring-boot.build-image.skip=true -->
                    <execution>
                        <goals>
                            <goal>build-image-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
