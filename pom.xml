<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        The chess site, built together:
          chess-engine-api  the messages the web app and the engine exchange over ActiveMQ, and the rules of chess (Chess.js)
          chess-engine      plays moves: takes move requests off the queue, runs them through Chess.js on GraalJS, replies
          3D-WebGL-CHESS    the web app: pages, sign-in, games, clocks, ratings; asks the engine for every move
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath />
    </parent>

    <groupId>com.jblazing</groupId>
    <artifactId>chess-parent</artifactId>
    <version>0.0.1</version>
    <packaging>pom</packaging>

    <!-- where mvn release:prepare commits and tags: the project's GitLab repository, from GitLab CI's predefined
         variables, so releases run in the pipeline (.gitlab-ci.yml). The modules use the same repository: the
         append.path attributes stop Maven adding their names to these URLs -->
    <scm child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false" child.scm.url.inherit.append.path="false">
        <connection>scm:git:${env.CI_SERVER_URL}/${env.CI_PROJECT_PATH}.git</connection>
        <developerConnection>scm:git:${env.CI_SERVER_URL}/${env.CI_PROJECT_PATH}.git</developerConnection>
        <url>${env.CI_PROJECT_URL}</url>
        <tag>v0.0.1</tag>
    </scm>

    <modules>
        <module>chess-engine-api</module>
        <module>chess-engine</module>
        <module>3D-WebGL-CHESS</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <spring.boot.version>3.5.16</spring.boot.version>
        <graaljs.version>25.4.4.1.1</graaljs.version>
        <!-- the GraalVM CE release with the same version, for the chess engine's base image
             (chess-engine/Dockerfile): change it together with graaljs.version -->
        <graalvm.release>graal-25.4.4.1.1</graalvm.release>
        <graalvm.archive>graalvm-community-jdk-25i4-25.0.4.1.1</graalvm.archive>
        <loombok.version>1.18.48</loombok.version>
        <!-- no Maven repository to upload jars to: deploy only pushes the docker images -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <!-- where deploy pushes the images (host:port): the REGISTRY environment variable, which the CI runner
             sets, or -Ddocker.registry=host:port. Deploy stops if neither is set (require-docker-registry). -->
        <docker.registry>${env.REGISTRY}</docker.registry>
        <!-- modules with an image to push turn this off -->
        <docker.push.skip>true</docker.push.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.jblazing</groupId>
                <artifactId>chess-engine-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jblazing</groupId>
                <artifactId>chess-engine</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <docker>
                            <!-- the image builder gets the DOCKER_HOST socket, not /var/run/docker.sock:
                                 needed for rootless Podman (DOCKER_HOST=unix:///run/user/1000/podman/podman.sock) -->
                            <bindHostToBuilder>true</bindHostToBuilder>
                        </docker>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!--
                Releases: mvn release:prepare sets the release version in every module, commits, tags it
                v<version> and moves on to the next -SNAPSHOT; mvn release:perform builds the tag and runs
                deploy, which pushes the images (docker.registry). Both push to the scm repository above.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-release-plugin</artifactId>
                <version>3.3.1</version>
                <configuration>
                    <tagNameFormat>v@{project.version}</tagNameFormat>
                    <!-- one version for all the modules, asked for once -->
                    <autoVersionSubmodules>true</autoVersionSubmodules>
                </configuration>
            </plugin>

            <!-- on deploy, in the modules that push an image: stops it before the push when docker.registry
                 isn't set, instead of pushing to "${env.REGISTRY}/..." -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>require-docker-registry</id>
                        <phase>deploy</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <skip>${docker.push.skip}</skip>
                            <rules>
                                <requireProperty>
                                    <property>docker.registry</property>
                                    <message>No registry to push the images to: set REGISTRY (e.g. REGISTRY=pi:5000) or -Ddocker.registry=host:port, or skip the pushes with -Ddocker.push.skip=true</message>
                                    <regex>[^$]+</regex>
                                    <regexMessage>No registry to push the images to: set REGISTRY (e.g. REGISTRY=pi:5000) or -Ddocker.registry=host:port, or skip the pushes with -Ddocker.push.skip=true</regexMessage>
                                </requireProperty>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
