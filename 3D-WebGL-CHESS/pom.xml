<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.jblazing</groupId>
        <artifactId>chess-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>3D-WebGL-CHESS</artifactId>

    <properties>
        <embedded.postgres.version>2.1.0</embedded.postgres.version>
        <embedded.postgres.binaries.version>16.4.0</embedded.postgres.binaries.version>
        <!-- docker image names must be lowercase, unlike the artifactId -->
        <docker.image>3d-webgl-chess:${project.version}</docker.image>
        <spring-boot.build-image.skip>false</spring-boot.build-image.skip>
        <docker.push.skip>${spring-boot.build-image.skip}</docker.push.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- PostgreSQL server binaries for the tests' embedded database -->
            <dependency>
                <groupId>io.zonky.test.postgres</groupId>
                <artifactId>embedded-postgres-binaries-bom</artifactId>
                <version>${embedded.postgres.binaries.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Additional lines to be added here... -->
    <dependencies>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <version>${spring.boot.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
            <version>${spring.boot.version}</version>
        </dependency>

        <!-- Persistence: JPA on PostgreSQL, with Liquibase migrations -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
            <version>${spring.boot.version}</version>
        </dependency>

        <dependency>
            <groupId>org.liquibase</groupId>
            <artifactId>liquibase-core</artifactId>
        </dependency>

        <!-- Sessions (and so sign-ins) are kept in the database, surviving server restarts -->
        <dependency>
            <groupId>org.springframework.session</groupId>
            <artifactId>spring-session-jdbc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Moves are played by the chess engine service, asked over ActiveMQ (ChessEngineClient) -->
        <dependency>
            <groupId>com.jblazing</groupId>
            <artifactId>chess-engine-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-activemq</artifactId>
        </dependency>

        <!-- Games in play are cached in Redis (RedisGameStateCache) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${loombok.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Tests: JUnit 5, AssertJ, Mockito, Spring test support -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <version>${spring.boot.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- A real PostgreSQL server started by the tests. Linux and macOS binaries come with it;
             Windows needs its own. (The CI pipeline uses a PostgreSQL service instead: TestDatabases.) -->
        <dependency>
            <groupId>io.zonky.test</groupId>
            <artifactId>embedded-postgres</artifactId>
            <version>${embedded.postgres.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.zonky.test.postgres</groupId>
            <artifactId>embedded-postgres-binaries-windows-amd64</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- A real Redis server for the tests, in a container: needs Docker (or Podman via DOCKER_HOST) -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- The real chess engine, run by the tests on an ActiveMQ broker inside the test JVM (vm://) -->
        <dependency>
            <groupId>com.jblazing</groupId>
            <artifactId>chess-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.activemq</groupId>
            <artifactId>activemq-broker</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>
    <build>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <!-- JDK 23+ no longer runs annotation processors found on the classpath by default -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${loombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <image>
                        <name>${docker.image}</name>
                    </image>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>build-image-no-fork</goal>
                        </goals>
                    </execution>

                    <!-- on deploy, builds the image for amd64 and arm64 (the pi) and publishes each to
                         docker.registry (root pom) under its own tag; docker-manifest below joins them.
                         Buildpacks build one platform at a time, and the other one runs under emulation.
                         Skip with -Ddocker.push.skip=true -->
                    <execution>
                        <id>image-amd64</id>
                        <phase>deploy</phase>
                        <goals>
                            <goal>build-image-no-fork</goal>
                        </goals>
                        <configuration>
                            <skip>${docker.push.skip}</skip>
                            <image>
                                <name>${docker.registry}/${docker.image}-amd64</name>
                                <imagePlatform>linux/amd64</imagePlatform>
                                <publish>true</publish>
                            </image>
                        </configuration>
                    </execution>
                    <execution>
                        <id>image-arm64</id>
                        <phase>deploy</phase>
                        <goals>
                            <goal>build-image-no-fork</goal>
                        </goals>
                        <configuration>
                            <skip>${docker.push.skip}</skip>
                            <image>
                                <name>${docker.registry}/${docker.image}-arm64</name>
                                <imagePlatform>linux/arm64</imagePlatform>
                                <publish>true</publish>
                            </image>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- on deploy, after the per-platform images: the multi-arch tag ${docker.registry}/${docker.image}
                 listing both. insecure: the registry is plain HTTP; amend and purge let it re-run -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>docker-manifest</id>
                        <phase>deploy</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>${docker.push.skip}</skip>
                            <executable>docker</executable>
                            <arguments>
                                <argument>manifest</argument>
                                <argument>create</argument>
                                <argument>--amend</argument>
                                <argument>--insecure</argument>
                                <argument>${docker.registry}/${docker.image}</argument>
                                <argument>${docker.registry}/${docker.image}-amd64</argument>
                                <argument>${docker.registry}/${docker.image}-arm64</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>docker-manifest-push</id>
                        <phase>deploy</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>${docker.push.skip}</skip>
                            <executable>docker</executable>
                            <arguments>
                                <argument>manifest</argument>
                                <argument>push</argument>
                                <argument>--insecure</argument>
                                <argument>--purge</argument>
                                <argument>${docker.registry}/${docker.image}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>